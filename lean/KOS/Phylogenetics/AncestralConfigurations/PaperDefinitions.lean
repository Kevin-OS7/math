import KOS.Phylogenetics.AncestralConfigurations.Main

/-!
# Root ancestral configurations in the original terms of Disanto and Rosenberg

F. Disanto and N. A. Rosenberg, *On the number of non-equivalent ancestral configurations for
matching gene trees and species trees*, Bull. Math. Biol. 81 (2019) 384–407.

The statement `KOS.AncestralConfigurations.disanto_rosenberg` counts isomorphism classes of
non-trivial prunings (`BTree.rootConfigs`).  This file formalizes the definitions of the paper
itself and proves that they give the same number.

* Nodes of a tree, and the gene lineages of the matching gene tree `G = t`, are paths from the
  root (`Node = List Bool`).
* `BTree.configsAt t κ` is the set `C(κ)` of ancestral configurations at a node `κ`, defined by the
  decomposition displayed in Section 2.4, with no configurations at a leaf (Section 2.3);
  `paperConfigs T` is the set `C(r)` of root configurations.
* `BTree.restrictAt t κ X` is the restriction `t_κ(X)` of Section 3.1 (all nodes strictly below
  nodes of `X` are removed) and `restrict T X` is its root version.  `nodes_restrict` and
  `nodes_injective` show that `restrict T X` is the tree described in the paper.
* `paperRootConfigsNonequiv T` is `c*(r)`, the number of classes of root configurations under
  `γ₁ ∼ γ₂ ↔ t(γ₁) ≅ t(γ₂)` (Section 3.1); `nonequivConfigsAt T κ` is `c*(κ)` at any node `κ`.

Main results: `paperRootConfigsNonequiv_eq_rootConfigs` and `disanto_rosenberg_paper`, with the
sanity checks `card_configsAt_node` and `card_paperConfigs_node` (eq. (5)), the worked example of
Fig. 1 of the paper (namespace `Fig1`: `C(g)`, `C(j)`, `C(k)`, the restrictions and equivalences
of Section 3.1, and `c*(j) = 3` from Fig. 2), `c*(r) = 3` for both shapes with four leaves
(Section 3.2), and the sequence of maxima listed in the caption of Fig. 5.

The last part of the file defines `C(κ)` directly from realizations of the gene tree in a dated
species tree, as in eq. (3) of Section 2.3 (`SpeciesTree`, `Realization`, `Realization.config`,
`realizationConfigs`), proves that this agrees with the recursion of Section 2.4 at every node
(`realizationConfigs_eq_configsAt`), and restates the theorem in these terms
(`disanto_rosenberg_realizations`).
-/

namespace KOS.AncestralConfigurations

/-- A node of a tree, written as its path from the root (`false`: go to the left child, `true`:
go to the right child).  The root is `[]`; the children of a node `κ` are `κ ++ [false]` and
`κ ++ [true]`. -/
abbrev Node := List Bool

/-- A gene lineage of the matching gene tree `G = t`.  As in Fig. 1 of the paper, "each lineage
(edge) of t is identified by the lowest node it intersects", so a lineage is named by a node. -/
abbrev Lineage := Node

/-- `A ⊗ B = {a ∪ b : a ∈ A, b ∈ B}` for two sets of sets `A`, `B` (Section 2.4). -/
def otimes (A B : Finset (Finset Lineage)) : Finset (Finset Lineage) :=
  Finset.image₂ (· ∪ ·) A B

@[inherit_doc] local infixl:70 " ⊗ " => otimes

namespace BTree

/-- The nodes of the subtree `t_κ = t` generated by the node `κ`, as nodes of the ambient tree
(that is, as paths from the ambient root). -/
def nodesAt : BTree → Node → Finset Node
  | leaf, κ => {κ}
  | node l r, κ => insert κ (nodesAt l (κ ++ [false]) ∪ nodesAt r (κ ++ [true]))

/-- The nodes of `T`. -/
def nodes (T : BTree) : Finset Node := T.nodesAt []

/-- **Section 2.4.**  `t.configsAt κ` is the set `C(κ)` of ancestral configurations at the node `κ`
of the ambient tree, where `t = t_κ` is the subtree generated by `κ`.  A leaf has no ancestral
configurations (Section 2.3); at an internal node `κ` with children `κℓ = κ ++ [false]` and
`κr = κ ++ [true]`,
`C(κ) = {{κℓ, κr}} ∪ [C(κℓ) ⊗ {{κr}}] ∪ [{{κℓ}} ⊗ C(κr)] ∪ [C(κℓ) ⊗ C(κr)]`. -/
def configsAt : BTree → Node → Finset (Finset Lineage)
  | leaf, _ => ∅
  | node l r, κ =>
      {{κ ++ [false], κ ++ [true]}} ∪ (configsAt l (κ ++ [false]) ⊗ {{κ ++ [true]}}) ∪
        ({{κ ++ [false]}} ⊗ configsAt r (κ ++ [true])) ∪
        (configsAt l (κ ++ [false]) ⊗ configsAt r (κ ++ [true]))

/-- **Section 3.1.**  `t.restrictAt κ X` is the restriction `t_κ(X)`: the tree obtained from the
subtree `t_κ = t` generated by `κ` by removing all nodes that lie strictly below nodes of `X`.
Walking down from `κ`, a node of `X` keeps its place but loses everything below it (so it becomes
a leaf), and a node not in `X` keeps both of its children.  (`nodesAt_restrictAt` shows that the
nodes of `t_κ(X)` are exactly the nodes of `t_κ` that are not strictly below a node of `X`.) -/
def restrictAt : BTree → Node → Finset Node → BTree
  | leaf, _, _ => leaf
  | node l r, κ, X =>
      if κ ∈ X then leaf else node (restrictAt l (κ ++ [false]) X) (restrictAt r (κ ++ [true]) X)

theorem Iso.refl (T : BTree) : Iso T T := (iso_iff_code_eq T T).mpr rfl

theorem Iso.symm {T U : BTree} (h : Iso T U) : Iso U T :=
  (iso_iff_code_eq U T).mpr ((iso_iff_code_eq T U).mp h).symm

theorem Iso.trans {T U V : BTree} (h₁ : Iso T U) (h₂ : Iso U V) : Iso T V :=
  (iso_iff_code_eq T V).mpr (((iso_iff_code_eq T U).mp h₁).trans ((iso_iff_code_eq U V).mp h₂))

end BTree

open BTree

/-- The set `C(r)` of root ancestral configurations of the matching gene tree / species tree
pair with tree `T` (Sections 2.3–2.4); the root is the node `[]`. -/
def paperConfigs (T : BTree) : Finset (Finset Lineage) := T.configsAt []

/-- The restriction `t_r(X)` of `T = t_r` to a set `X` of nodes (Section 3.1): remove from `T`
all nodes that lie strictly below the nodes belonging to `X`. -/
def restrict (T : BTree) (X : Finset Node) : BTree := T.restrictAt [] X

/-- **Section 3.1.**  Two root configurations `γ₁, γ₂ ∈ C(r)` are equivalent, `γ₁ ∼ γ₂`, when the
tree shape `t(γ₁)` is isomorphic to the tree shape `t(γ₂)`. -/
def rootConfigEquiv (T : BTree) : Setoid {γ // γ ∈ paperConfigs T} where
  r γ₁ γ₂ := Iso (restrict T γ₁) (restrict T γ₂)
  iseqv := ⟨fun _ => Iso.refl _, fun h => h.symm, fun h₁ h₂ => h₁.trans h₂⟩

/-- **Section 3.1.**  The number `c*(r) = |C*(r)|` of non-equivalent root configurations: the
number of equivalence classes of root configurations. -/
noncomputable def paperRootConfigsNonequiv (T : BTree) : ℕ :=
  Nat.card (Quotient (rootConfigEquiv T))

/-! ## Paths -/

theorem not_below_both {κ x : Node} (h₁ : κ ++ [false] <+: x) (h₂ : κ ++ [true] <+: x) :
    False := by
  have h := List.prefix_of_prefix_length_le h₁ h₂ (by simp)
  rw [List.prefix_append_right_inj] at h
  simp at h

theorem not_child_prefix_self (κ : Node) (b : Bool) : ¬ κ ++ [b] <+: κ := by
  intro h
  have := h.length_le
  simp at this

theorem child_prefix_of_prefix {κ x p : Node} {b : Bool} (hκx : κ <+: x) (hx : x ≠ κ)
    (hxp : x <+: p) (hbp : κ ++ [b] <+: p) : κ ++ [b] <+: x := by
  apply List.prefix_of_prefix_length_le hbp hxp
  have h₁ := hκx.length_le
  have h₂ : κ.length ≠ x.length := fun h => hx (hκx.eq_of_length h).symm
  simp only [List.length_append, List.length_singleton]
  omega

theorem prefix_dropLast_of_ne {x u : Node} (h : x <+: u) (hne : x ≠ u) : x <+: u.dropLast := by
  obtain ⟨t, rfl⟩ := h
  have ht : t ≠ [] := by
    rintro rfl
    simp at hne
  rw [List.dropLast_append_of_ne_nil ht]
  exact List.prefix_append _ _

theorem eq_of_prefix_of_prefix {x y : Node} (h₁ : x <+: y) (h₂ : y <+: x) : x = y :=
  h₁.eq_of_length (le_antisymm h₁.length_le h₂.length_le)

namespace BTree

/-! ## Nodes, leaves, internal nodes and subtrees -/

/-- The leaves of the subtree `t_κ = t`, as nodes of the ambient tree. -/
def leafNodesAt : BTree → Node → Finset Node
  | leaf, κ => {κ}
  | node l r, κ => leafNodesAt l (κ ++ [false]) ∪ leafNodesAt r (κ ++ [true])

/-- The internal nodes of the subtree `t_κ = t`, as nodes of the ambient tree. -/
def internalNodesAt : BTree → Node → Finset Node
  | leaf, _ => ∅
  | node l r, κ => insert κ (internalNodesAt l (κ ++ [false]) ∪ internalNodesAt r (κ ++ [true]))

/-- The leaves of `T`. -/
def leafNodes (T : BTree) : Finset Node := T.leafNodesAt []

/-- The internal nodes of `T`. -/
def internalNodes (T : BTree) : Finset Node := T.internalNodesAt []

/-- The subtree `t_κ` of `t` generated by the node `κ` (`κ` and all nodes below it). -/
def subtree : BTree → Node → BTree
  | t, [] => t
  | leaf, _ :: _ => leaf
  | node l _, false :: κ => subtree l κ
  | node _ r, true :: κ => subtree r κ

theorem self_mem_nodesAt (t : BTree) (κ : Node) : κ ∈ t.nodesAt κ := by
  cases t <;> simp [nodesAt]

theorem prefix_of_mem_nodesAt {t : BTree} {κ u : Node} (h : u ∈ t.nodesAt κ) : κ <+: u := by
  induction t generalizing κ with
  | leaf =>
    rw [nodesAt, Finset.mem_singleton] at h
    rw [h]
  | node l r hl hr =>
    simp only [nodesAt, Finset.mem_insert, Finset.mem_union] at h
    rcases h with h | h | h
    · rw [h]
    · exact (List.prefix_append _ _).trans (hl h)
    · exact (List.prefix_append _ _).trans (hr h)

theorem leafNodesAt_subset (t : BTree) (κ : Node) : t.leafNodesAt κ ⊆ t.nodesAt κ := by
  induction t generalizing κ with
  | leaf => exact fun u hu => hu
  | node l r hl hr =>
    intro u hu
    rw [leafNodesAt, Finset.mem_union] at hu
    rw [nodesAt, Finset.mem_insert, Finset.mem_union]
    exact Or.inr (hu.imp (fun h => hl _ h) (fun h => hr _ h))

theorem internalNodesAt_subset (t : BTree) (κ : Node) : t.internalNodesAt κ ⊆ t.nodesAt κ := by
  induction t generalizing κ with
  | leaf => intro u hu; simp [internalNodesAt] at hu
  | node l r hl hr =>
    intro u hu
    rw [internalNodesAt, Finset.mem_insert, Finset.mem_union] at hu
    rw [nodesAt, Finset.mem_insert, Finset.mem_union]
    exact hu.imp id (fun h => h.imp (fun h => hl _ h) (fun h => hr _ h))

/-- Every node is a leaf or an internal node. -/
theorem mem_nodesAt_iff (t : BTree) (κ u : Node) :
    u ∈ t.nodesAt κ ↔ u ∈ t.leafNodesAt κ ∨ u ∈ t.internalNodesAt κ := by
  induction t generalizing κ with
  | leaf => simp [nodesAt, leafNodesAt, internalNodesAt]
  | node l r hl hr =>
    simp only [nodesAt, leafNodesAt, internalNodesAt, Finset.mem_insert, Finset.mem_union, hl, hr]
    tauto

/-- No node is both a leaf and an internal node. -/
theorem not_mem_leaf_internal {t : BTree} {κ u : Node} (hl : u ∈ t.leafNodesAt κ)
    (hi : u ∈ t.internalNodesAt κ) : False := by
  induction t generalizing κ with
  | leaf => simp [internalNodesAt] at hi
  | node l r ihl ihr =>
    rw [leafNodesAt, Finset.mem_union] at hl
    rw [internalNodesAt, Finset.mem_insert, Finset.mem_union] at hi
    rcases hl with hl | hl
    · have hp := prefix_of_mem_nodesAt (leafNodesAt_subset _ _ hl)
      rcases hi with hi | hi | hi
      · rw [hi] at hp
        exact not_child_prefix_self _ _ hp
      · exact ihl hl hi
      · exact not_below_both hp (prefix_of_mem_nodesAt (internalNodesAt_subset _ _ hi))
    · have hp := prefix_of_mem_nodesAt (leafNodesAt_subset _ _ hl)
      rcases hi with hi | hi | hi
      · rw [hi] at hp
        exact not_child_prefix_self _ _ hp
      · exact not_below_both (prefix_of_mem_nodesAt (internalNodesAt_subset _ _ hi)) hp
      · exact ihr hl hi

theorem child_mem_nodesAt {t : BTree} {κ v : Node} (hv : v ∈ t.internalNodesAt κ) (b : Bool) :
    v ++ [b] ∈ t.nodesAt κ := by
  induction t generalizing κ with
  | leaf => simp [internalNodesAt] at hv
  | node l r hl hr =>
    simp only [internalNodesAt, Finset.mem_insert, Finset.mem_union] at hv
    simp only [nodesAt, Finset.mem_insert, Finset.mem_union]
    rcases hv with hv | hv | hv
    · rw [hv]
      cases b
      · exact Or.inr (Or.inl (self_mem_nodesAt _ _))
      · exact Or.inr (Or.inr (self_mem_nodesAt _ _))
    · exact Or.inr (Or.inl (hl hv))
    · exact Or.inr (Or.inr (hr hv))

/-- The parent `u.dropLast` of a non-root node `u` is an internal node. -/
theorem dropLast_mem_internalNodesAt {t : BTree} {κ u : Node} (hu : u ∈ t.nodesAt κ)
    (hne : u ≠ κ) : u.dropLast ∈ t.internalNodesAt κ := by
  induction t generalizing κ with
  | leaf =>
    rw [nodesAt, Finset.mem_singleton] at hu
    exact absurd hu hne
  | node l r hl hr =>
    simp only [nodesAt, Finset.mem_insert, Finset.mem_union] at hu
    simp only [internalNodesAt, Finset.mem_insert, Finset.mem_union]
    rcases hu with hu | hu | hu
    · exact absurd hu hne
    · by_cases h : u = κ ++ [false]
      · left
        rw [h, List.dropLast_concat]
      · exact Or.inr (Or.inl (hl hu h))
    · by_cases h : u = κ ++ [true]
      · left
        rw [h, List.dropLast_concat]
      · exact Or.inr (Or.inr (hr hu h))

/-- **Subtrees.**  The nodes (leaves, internal nodes) of the subtree `t_{κ ++ p}` are the nodes
(leaves, internal nodes) of `t_κ` below `κ ++ p`. -/
theorem subtree_nodesAt (t : BTree) (κ p : Node) (hp : κ ++ p ∈ t.nodesAt κ) :
    (t.subtree p).nodesAt (κ ++ p) = (t.nodesAt κ).filter (κ ++ p <+: ·) ∧
      (t.subtree p).leafNodesAt (κ ++ p) = (t.leafNodesAt κ).filter (κ ++ p <+: ·) ∧
      (t.subtree p).internalNodesAt (κ ++ p) = (t.internalNodesAt κ).filter (κ ++ p <+: ·) := by
  induction t generalizing κ p with
  | leaf =>
    cases p with
    | nil => simp [subtree, nodesAt, leafNodesAt, internalNodesAt, Finset.filter_singleton]
    | cons b p =>
      rw [nodesAt, Finset.mem_singleton] at hp
      have := congrArg List.length hp
      simp at this
  | node l r hl hr =>
    cases p with
    | nil =>
      simp only [List.append_nil, subtree]
      refine ⟨?_, ?_, ?_⟩ <;> refine (Finset.filter_true_of_mem fun u hu => ?_).symm
      · exact prefix_of_mem_nodesAt hu
      · exact prefix_of_mem_nodesAt (leafNodesAt_subset _ _ hu)
      · exact prefix_of_mem_nodesAt (internalNodesAt_subset _ _ hu)
    | cons b p =>
      have e : κ ++ b :: p = κ ++ [b] ++ p := by simp
      rw [e] at hp ⊢
      have hκ : ¬ (κ ++ [b] ++ p <+: κ) := fun h => by
        have := h.length_le
        simp at this
      cases b with
      | false =>
        have hoff : ∀ u, κ ++ [true] <+: u → ¬ (κ ++ [false] ++ p <+: u) :=
          fun u h₁ h₂ => not_below_both ((List.prefix_append _ _).trans h₂) h₁
        have hp' : κ ++ [false] ++ p ∈ l.nodesAt (κ ++ [false]) := by
          rw [nodesAt, Finset.mem_insert, Finset.mem_union] at hp
          rcases hp with hp | hp | hp
          · exact absurd (by rw [hp]) hκ
          · exact hp
          · exact absurd (List.prefix_refl _) (hoff _ (prefix_of_mem_nodesAt hp))
        obtain ⟨h₁, h₂, h₃⟩ := hl (κ ++ [false]) p hp'
        simp only [subtree]
        refine ⟨?_, ?_, ?_⟩
        · rw [h₁, nodesAt, Finset.filter_insert, if_neg hκ, Finset.filter_union,
            Finset.filter_false_of_mem (fun u hu => hoff u (prefix_of_mem_nodesAt hu)),
            Finset.union_empty]
        · rw [h₂, leafNodesAt, Finset.filter_union,
            Finset.filter_false_of_mem
              (fun u hu => hoff u (prefix_of_mem_nodesAt (leafNodesAt_subset _ _ hu))),
            Finset.union_empty]
        · rw [h₃, internalNodesAt, Finset.filter_insert, if_neg hκ, Finset.filter_union,
            Finset.filter_false_of_mem
              (fun u hu => hoff u (prefix_of_mem_nodesAt (internalNodesAt_subset _ _ hu))),
            Finset.union_empty]
      | true =>
        have hoff : ∀ u, κ ++ [false] <+: u → ¬ (κ ++ [true] ++ p <+: u) :=
          fun u h₁ h₂ => not_below_both h₁ ((List.prefix_append _ _).trans h₂)
        have hp' : κ ++ [true] ++ p ∈ r.nodesAt (κ ++ [true]) := by
          rw [nodesAt, Finset.mem_insert, Finset.mem_union] at hp
          rcases hp with hp | hp | hp
          · exact absurd (by rw [hp]) hκ
          · exact absurd (List.prefix_refl _) (hoff _ (prefix_of_mem_nodesAt hp))
          · exact hp
        obtain ⟨h₁, h₂, h₃⟩ := hr (κ ++ [true]) p hp'
        simp only [subtree]
        refine ⟨?_, ?_, ?_⟩
        · rw [h₁, nodesAt, Finset.filter_insert, if_neg hκ, Finset.filter_union,
            Finset.filter_false_of_mem (fun u hu => hoff u (prefix_of_mem_nodesAt hu)),
            Finset.empty_union]
        · rw [h₂, leafNodesAt, Finset.filter_union,
            Finset.filter_false_of_mem
              (fun u hu => hoff u (prefix_of_mem_nodesAt (leafNodesAt_subset _ _ hu))),
            Finset.empty_union]
        · rw [h₃, internalNodesAt, Finset.filter_insert, if_neg hκ, Finset.filter_union,
            Finset.filter_false_of_mem
              (fun u hu => hoff u (prefix_of_mem_nodesAt (internalNodesAt_subset _ _ hu))),
            Finset.empty_union]

/-- The subtree generated by a node `κ` of `T`, located at `κ`. -/
theorem subtree_nodes (T : BTree) {κ : Node} (hκ : κ ∈ T.nodes) :
    (T.subtree κ).nodesAt κ = T.nodes.filter (κ <+: ·) ∧
      (T.subtree κ).leafNodesAt κ = T.leafNodes.filter (κ <+: ·) ∧
      (T.subtree κ).internalNodesAt κ = T.internalNodes.filter (κ <+: ·) :=
  subtree_nodesAt T [] κ hκ

/-- A function that decreases from parents to children is antitone along the tree. -/
theorem antitone_nodesAt {t : BTree} {κ : Node} (f : Node → ℝ)
    (hf : ∀ v ∈ t.internalNodesAt κ, ∀ b, f (v ++ [b]) < f v) :
    ∀ u ∈ t.nodesAt κ, f u ≤ f κ ∧ (u ≠ κ → f u < f κ) := by
  induction t generalizing κ with
  | leaf =>
    intro u hu
    rw [nodesAt, Finset.mem_singleton] at hu
    rw [hu]
    exact ⟨le_rfl, fun h => absurd rfl h⟩
  | node l r hl hr =>
    have hl' := hl (κ := κ ++ [false]) (fun v hv => hf v (by simp [internalNodesAt, hv]))
    have hr' := hr (κ := κ ++ [true]) (fun v hv => hf v (by simp [internalNodesAt, hv]))
    have h₁ := hf κ (by simp [internalNodesAt]) false
    have h₂ := hf κ (by simp [internalNodesAt]) true
    intro u hu
    rw [nodesAt, Finset.mem_insert, Finset.mem_union] at hu
    rcases hu with hu | hu | hu
    · rw [hu]
      exact ⟨le_rfl, fun h => absurd rfl h⟩
    · have := (hl' u hu).1
      exact ⟨by linarith, fun _ => by linarith⟩
    · have := (hr' u hu).1
      exact ⟨by linarith, fun _ => by linarith⟩

/-- A function that vanishes at the leaves and decreases from parents to children is
nonnegative. -/
theorem nonneg_nodesAt {t : BTree} {κ : Node} (f : Node → ℝ)
    (h₀ : ∀ v ∈ t.leafNodesAt κ, f v = 0)
    (hf : ∀ v ∈ t.internalNodesAt κ, ∀ b, f (v ++ [b]) < f v) : ∀ u ∈ t.nodesAt κ, 0 ≤ f u := by
  induction t generalizing κ with
  | leaf =>
    intro u hu
    rw [nodesAt, Finset.mem_singleton] at hu
    rw [hu, h₀ κ (by simp [leafNodesAt])]
  | node l r hl hr =>
    have hl' := hl (κ := κ ++ [false]) (fun v hv => h₀ v (by simp [leafNodesAt, hv]))
      (fun v hv => hf v (by simp [internalNodesAt, hv]))
    have hr' := hr (κ := κ ++ [true]) (fun v hv => h₀ v (by simp [leafNodesAt, hv]))
      (fun v hv => hf v (by simp [internalNodesAt, hv]))
    intro u hu
    rw [nodesAt, Finset.mem_insert, Finset.mem_union] at hu
    rcases hu with hu | hu | hu
    · rw [hu]
      have h₁ := hl' _ (self_mem_nodesAt _ _)
      have h₂ := hf κ (by simp [internalNodesAt]) false
      linarith
    · exact hl' u hu
    · exact hr' u hu

/-! ## The restriction `t_κ(X)` is the tree described in Section 3.1 -/

/-- The nodes of `t_κ(X)` are exactly the nodes of `t_κ` that do not lie strictly below a node
of `X` (belonging to `t_κ`). -/
theorem nodesAt_restrictAt (t : BTree) (κ : Node) (X : Finset Node) :
    (t.restrictAt κ X).nodesAt κ =
      (t.nodesAt κ).filter (fun p => ¬ ∃ x ∈ X, κ <+: x ∧ x <+: p ∧ x ≠ p) := by
  have hroot : ∀ κ : Node, ¬ ∃ x ∈ X, κ <+: x ∧ x <+: κ ∧ x ≠ κ :=
    fun κ ⟨x, _, h₁, h₂, h₃⟩ => h₃ (eq_of_prefix_of_prefix h₁ h₂).symm
  induction t generalizing κ with
  | leaf =>
    rw [restrictAt, nodesAt, Finset.filter_singleton, if_pos (hroot κ)]
  | node l r hl hr =>
    by_cases hκ : κ ∈ X
    · rw [restrictAt, if_pos hκ, nodesAt]
      ext u
      simp only [Finset.mem_singleton, Finset.mem_filter, nodesAt, Finset.mem_insert,
        Finset.mem_union]
      constructor
      · rintro rfl
        exact ⟨Or.inl rfl, hroot u⟩
      · rintro ⟨hu | hu, hn⟩
        · exact hu
        · exfalso
          have hp : ∃ b, κ ++ [b] <+: u := by
            rcases hu with hu | hu
            · exact ⟨false, prefix_of_mem_nodesAt hu⟩
            · exact ⟨true, prefix_of_mem_nodesAt hu⟩
          obtain ⟨b, hb⟩ := hp
          refine hn ⟨κ, hκ, List.prefix_refl _, (List.prefix_append _ _).trans hb, ?_⟩
          rintro rfl
          exact not_child_prefix_self _ _ hb
    · rw [restrictAt, if_neg hκ, nodesAt, hl, hr, nodesAt]
      ext u
      simp only [Finset.mem_insert, Finset.mem_union, Finset.mem_filter]
      constructor
      · rintro (hu | ⟨hu, hn⟩ | ⟨hu, hn⟩)
        · rw [hu]
          exact ⟨Or.inl rfl, hroot κ⟩
        · refine ⟨Or.inr (Or.inl hu), ?_⟩
          rintro ⟨x, hx, h₁, h₂, h₃⟩
          exact hn ⟨x, hx, child_prefix_of_prefix h₁ (fun h => hκ (h ▸ hx)) h₂
            (prefix_of_mem_nodesAt hu), h₂, h₃⟩
        · refine ⟨Or.inr (Or.inr hu), ?_⟩
          rintro ⟨x, hx, h₁, h₂, h₃⟩
          exact hn ⟨x, hx, child_prefix_of_prefix h₁ (fun h => hκ (h ▸ hx)) h₂
            (prefix_of_mem_nodesAt hu), h₂, h₃⟩
      · rintro ⟨hu | hu | hu, hn⟩
        · exact Or.inl hu
        · refine Or.inr (Or.inl ⟨hu, ?_⟩)
          rintro ⟨x, hx, h₁, h₂, h₃⟩
          exact hn ⟨x, hx, (List.prefix_append _ _).trans h₁, h₂, h₃⟩
        · refine Or.inr (Or.inr ⟨hu, ?_⟩)
          rintro ⟨x, hx, h₁, h₂, h₃⟩
          exact hn ⟨x, hx, (List.prefix_append _ _).trans h₁, h₂, h₃⟩

/-- A tree is determined by its set of nodes. -/
theorem nodesAt_injective {t u : BTree} {κ : Node} (h : t.nodesAt κ = u.nodesAt κ) : t = u := by
  induction t generalizing u κ with
  | leaf =>
    cases u with
    | leaf => rfl
    | node l r =>
      have hm : κ ++ [false] ∈ (node l r).nodesAt κ := by
        simp [nodesAt, self_mem_nodesAt]
      rw [← h, nodesAt, Finset.mem_singleton] at hm
      have := congrArg List.length hm
      simp at this
  | node l r hl hr =>
    cases u with
    | leaf =>
      have hm : κ ++ [false] ∈ (node l r).nodesAt κ := by
        simp [nodesAt, self_mem_nodesAt]
      rw [h, nodesAt, Finset.mem_singleton] at hm
      have := congrArg List.length hm
      simp at this
    | node l' r' =>
      have hm : ∀ (a b : BTree) (c : Bool), κ ++ [c] ∈ (node a b).nodesAt κ := by
        intro a b c
        cases c <;> simp [nodesAt, self_mem_nodesAt]
      have hL := (subtree_nodesAt (node l r) κ [false] (hm l r false)).1
      have hL' := (subtree_nodesAt (node l' r') κ [false] (hm l' r' false)).1
      have hR := (subtree_nodesAt (node l r) κ [true] (hm l r true)).1
      have hR' := (subtree_nodesAt (node l' r') κ [true] (hm l' r' true)).1
      simp only [subtree] at hL hL' hR hR'
      have e₁ : l = l' := hl (κ := κ ++ [false]) (by rw [hL, h, ← hL'])
      have e₂ : r = r' := hr (κ := κ ++ [true]) (by rw [hR, h, ← hR'])
      rw [e₁, e₂]

end BTree

/-- **Section 3.1.**  The nodes of `t(X)` are the nodes of `T` that do not lie strictly below a
node of `X`. -/
theorem nodes_restrict (T : BTree) (X : Finset Node) :
    (restrict T X).nodes = T.nodes.filter (fun p => ¬ ∃ x ∈ X, x <+: p ∧ x ≠ p) := by
  simp only [restrict, BTree.nodes, nodesAt_restrictAt, List.nil_prefix, true_and]

/-- A tree is determined by its nodes; together with `nodes_restrict` this pins `restrict T X`
down as the tree described in Section 3.1. -/
theorem nodes_injective : Function.Injective BTree.nodes :=
  fun _ _ h => nodesAt_injective h

/-! ## Configurations are the non-trivial cuts -/

namespace BTree

/-- All cuts of `t_κ`, including the trivial one `{κ}` (an auxiliary notion). -/
def cutsAt (t : BTree) (κ : Node) : Finset (Finset Lineage) := insert {κ} (t.configsAt κ)

@[simp] theorem configsAt_leaf (κ : Node) : configsAt leaf κ = ∅ := rfl

theorem configsAt_node (l r : BTree) (κ : Node) :
    configsAt (node l r) κ = cutsAt l (κ ++ [false]) ⊗ cutsAt r (κ ++ [true]) := by
  ext γ
  simp only [configsAt, cutsAt, otimes, Finset.mem_union, Finset.mem_image₂, Finset.mem_insert,
    Finset.mem_singleton]
  constructor
  · rintro (((rfl | ⟨a, ha, b, rfl, rfl⟩) | ⟨a, rfl, b, hb, rfl⟩) | ⟨a, ha, b, hb, rfl⟩)
    · exact ⟨_, Or.inl rfl, _, Or.inl rfl, (Finset.insert_eq _ _).symm⟩
    · exact ⟨a, Or.inr ha, _, Or.inl rfl, rfl⟩
    · exact ⟨_, Or.inl rfl, b, Or.inr hb, rfl⟩
    · exact ⟨a, Or.inr ha, b, Or.inr hb, rfl⟩
  · rintro ⟨a, (rfl | ha), b, (rfl | hb), rfl⟩
    · exact Or.inl (Or.inl (Or.inl (Finset.insert_eq _ _).symm))
    · exact Or.inl (Or.inr ⟨_, rfl, b, hb, rfl⟩)
    · exact Or.inl (Or.inl (Or.inr ⟨a, ha, _, rfl, rfl⟩))
    · exact Or.inr ⟨a, ha, b, hb, rfl⟩

/-- Every lineage of a configuration at `κ` lies strictly below `κ`. -/
theorem below_of_mem_configsAt {t : BTree} {κ : Node} {γ : Finset Lineage}
    (hγ : γ ∈ t.configsAt κ) {x : Lineage} (hx : x ∈ γ) : ∃ b, κ ++ [b] <+: x := by
  induction t generalizing κ γ with
  | leaf => simp at hγ
  | node l r hl hr =>
    rw [configsAt_node] at hγ
    simp only [otimes, cutsAt, Finset.mem_image₂, Finset.mem_insert] at hγ
    obtain ⟨a, ha, c, hc, rfl⟩ := hγ
    rcases Finset.mem_union.mp hx with hx | hx
    · refine ⟨false, ?_⟩
      rcases ha with rfl | ha
      · rw [Finset.mem_singleton.mp hx]
      · obtain ⟨b, hb⟩ := hl ha hx
        exact (List.prefix_append _ _).trans hb
    · refine ⟨true, ?_⟩
      rcases hc with rfl | hc
      · rw [Finset.mem_singleton.mp hx]
      · obtain ⟨b, hb⟩ := hr hc hx
        exact (List.prefix_append _ _).trans hb

theorem below_of_mem_cutsAt {t : BTree} {κ : Node} {γ : Finset Lineage}
    (hγ : γ ∈ t.cutsAt κ) {x : Lineage} (hx : x ∈ γ) : κ <+: x := by
  rcases Finset.mem_insert.mp hγ with rfl | hγ
  · rw [Finset.mem_singleton.mp hx]
  · obtain ⟨b, hb⟩ := below_of_mem_configsAt hγ hx
    exact (List.prefix_append _ _).trans hb

theorem singleton_notMem_configsAt (t : BTree) (κ : Node) : {κ} ∉ t.configsAt κ := by
  intro h
  obtain ⟨b, hb⟩ := below_of_mem_configsAt h (Finset.mem_singleton_self κ)
  exact not_child_prefix_self _ _ hb

/-- A cut of `t_κ` is a set of nodes of `t_κ` that covers every leaf and is an antichain. -/
theorem cutsAt_props {t : BTree} {κ : Node} {γ : Finset Lineage} (hγ : γ ∈ t.cutsAt κ) :
    γ ⊆ t.nodesAt κ ∧ (∀ u ∈ t.leafNodesAt κ, ∃ x ∈ γ, x <+: u) ∧
      ∀ x ∈ γ, ∀ y ∈ γ, x <+: y → x = y := by
  induction t generalizing κ γ with
  | leaf =>
    simp only [cutsAt, configsAt_leaf, Finset.mem_insert, Finset.notMem_empty, or_false] at hγ
    subst hγ
    refine ⟨by simp [nodesAt], fun u hu => ⟨κ, by simp, ?_⟩, by simp⟩
    rw [leafNodesAt, Finset.mem_singleton] at hu
    rw [hu]
  | node l r hl hr =>
    rcases Finset.mem_insert.mp hγ with rfl | hγ'
    · exact ⟨by simpa using self_mem_nodesAt (node l r) κ, fun u hu => ⟨κ, by simp,
        prefix_of_mem_nodesAt (leafNodesAt_subset _ _ hu)⟩, by simp⟩
    · rw [configsAt_node, otimes, Finset.mem_image₂] at hγ'
      obtain ⟨a, ha, c, hc, rfl⟩ := hγ'
      obtain ⟨ha₁, ha₂, ha₃⟩ := hl ha
      obtain ⟨hc₁, hc₂, hc₃⟩ := hr hc
      refine ⟨?_, ?_, ?_⟩
      · intro x hx
        simp only [nodesAt, Finset.mem_insert, Finset.mem_union]
        rcases Finset.mem_union.mp hx with hx | hx
        · exact Or.inr (Or.inl (ha₁ hx))
        · exact Or.inr (Or.inr (hc₁ hx))
      · intro u hu
        rw [leafNodesAt, Finset.mem_union] at hu
        rcases hu with hu | hu
        · obtain ⟨x, hx, hxu⟩ := ha₂ u hu
          exact ⟨x, Finset.mem_union_left _ hx, hxu⟩
        · obtain ⟨x, hx, hxu⟩ := hc₂ u hu
          exact ⟨x, Finset.mem_union_right _ hx, hxu⟩
      · intro x hx y hy hxy
        rcases Finset.mem_union.mp hx with hx | hx <;> rcases Finset.mem_union.mp hy with hy | hy
        · exact ha₃ x hx y hy hxy
        · exact (not_below_both ((below_of_mem_cutsAt ha hx).trans hxy)
            (below_of_mem_cutsAt hc hy)).elim
        · exact (not_below_both (below_of_mem_cutsAt ha hy)
            ((below_of_mem_cutsAt hc hx).trans hxy)).elim
        · exact hc₃ x hx y hy hxy

/-! ## Restrictions of configurations are the prunings -/

/-- `t_κ(X)` only depends on the nodes of `X` that lie in `t_κ`. -/
theorem restrictAt_congr (t : BTree) {κ : Node} {X Y : Finset Node}
    (h : ∀ x, κ <+: x → (x ∈ X ↔ x ∈ Y)) : t.restrictAt κ X = t.restrictAt κ Y := by
  induction t generalizing κ with
  | leaf => rfl
  | node l r hl hr =>
    simp only [restrictAt, h κ (List.prefix_refl κ)]
    rw [hl fun x hx => h x ((List.prefix_append _ _).trans hx),
      hr fun x hx => h x ((List.prefix_append _ _).trans hx)]

@[simp] theorem restrictAt_singleton (t : BTree) (κ : Node) : t.restrictAt κ {κ} = leaf := by
  cases t <;> simp [restrictAt]

theorem restrictAt_union {l r : BTree} {κ : Node} {a c : Finset Lineage}
    (ha : a ∈ l.cutsAt (κ ++ [false])) (hc : c ∈ r.cutsAt (κ ++ [true])) :
    (node l r).restrictAt κ (a ∪ c) =
      node (l.restrictAt (κ ++ [false]) a) (r.restrictAt (κ ++ [true]) c) := by
  have hκ : κ ∉ a ∪ c := by
    intro h
    rcases Finset.mem_union.mp h with h | h
    · exact not_child_prefix_self _ _ (below_of_mem_cutsAt ha h)
    · exact not_child_prefix_self _ _ (below_of_mem_cutsAt hc h)
  simp only [restrictAt, hκ, if_false]
  congr 1
  · apply restrictAt_congr
    intro x hx
    simp only [Finset.mem_union, or_iff_left_iff_imp]
    exact fun hxc => (not_below_both hx (below_of_mem_cutsAt hc hxc)).elim
  · apply restrictAt_congr
    intro x hx
    simp only [Finset.mem_union, or_iff_right_iff_imp]
    exact fun hxa => (not_below_both (below_of_mem_cutsAt ha hxa) hx).elim

/-- The restrictions of the configurations at `κ` are exactly the non-trivial prunings of
`t_κ`, and the restrictions of all cuts are all prunings. -/
theorem image_restrictAt (t : BTree) (κ : Node) :
    (t.configsAt κ).image (t.restrictAt κ) = t.prunings.erase leaf ∧
      (t.cutsAt κ).image (t.restrictAt κ) = t.prunings := by
  induction t generalizing κ with
  | leaf => simp [cutsAt, prunings]
  | node l r hl hr =>
    have h₁ : (configsAt (node l r) κ).image ((node l r).restrictAt κ) =
        (prunings (node l r)).erase leaf := by
      rw [prunings, Finset.erase_insert (by simp), ← (hl (κ ++ [false])).2,
        ← (hr (κ ++ [true])).2, configsAt_node]
      ext P
      simp only [otimes, Finset.mem_image, Finset.mem_image₂, Finset.mem_product, Prod.exists]
      constructor
      · rintro ⟨_, ⟨a, ha, c, hc, rfl⟩, rfl⟩
        exact ⟨_, _, ⟨⟨a, ha, rfl⟩, ⟨c, hc, rfl⟩⟩, (restrictAt_union ha hc).symm⟩
      · rintro ⟨_, _, ⟨⟨a, ha, rfl⟩, ⟨c, hc, rfl⟩⟩, rfl⟩
        exact ⟨_, ⟨a, ha, c, hc, rfl⟩, restrictAt_union ha hc⟩
    refine ⟨h₁, ?_⟩
    rw [cutsAt, Finset.image_insert, h₁, restrictAt_singleton,
      Finset.insert_erase (leaf_mem_prunings _)]

/-! ## The number of configurations: eq. (5) -/

/-- The number `c` of configurations given by the recursion (5) of the paper:
`c(r) = [c(rℓ) + 1][c(rr) + 1]`, and `c(r) = 0` for a one-leaf tree. -/
def numConfigs : BTree → ℕ
  | leaf => 0
  | node l r => (numConfigs l + 1) * (numConfigs r + 1)

/-- **Eq. (5)** at an internal node `κ`: `c(κ) = [c(κℓ) + 1][c(κr) + 1]`. -/
theorem card_configsAt_node (l r : BTree) (κ : Node) :
    ((node l r).configsAt κ).card =
      ((l.configsAt (κ ++ [false])).card + 1) * ((r.configsAt (κ ++ [true])).card + 1) := by
  have hinj : Set.InjOn (fun x : Finset Lineage × Finset Lineage => x.1 ∪ x.2)
      (↑(l.cutsAt (κ ++ [false])) ×ˢ ↑(r.cutsAt (κ ++ [true]))) := by
    rintro ⟨a, c⟩ ⟨ha, hc⟩ ⟨a', c'⟩ ⟨ha', hc'⟩ h
    simp only [Finset.mem_coe] at ha hc ha' hc'
    simp only at h
    have key : ∀ {a c : Finset Lineage}, a ∈ l.cutsAt (κ ++ [false]) →
        c ∈ r.cutsAt (κ ++ [true]) →
        (a ∪ c).filter (κ ++ [false] <+: ·) = a ∧ (a ∪ c).filter (κ ++ [true] <+: ·) = c := by
      intro a c ha hc
      rw [Finset.filter_union, Finset.filter_union,
        Finset.filter_true_of_mem (fun x hx => below_of_mem_cutsAt ha hx),
        Finset.filter_false_of_mem (fun x hx h => not_below_both h (below_of_mem_cutsAt hc hx)),
        Finset.filter_false_of_mem (fun x hx h => not_below_both (below_of_mem_cutsAt ha hx) h),
        Finset.filter_true_of_mem (fun x hx => below_of_mem_cutsAt hc hx),
        Finset.union_empty, Finset.empty_union]
      exact ⟨rfl, rfl⟩
    have e₁ := key ha hc
    have e₂ := key ha' hc'
    rw [h] at e₁
    exact Prod.ext (e₁.1.symm.trans e₂.1) (e₁.2.symm.trans e₂.2)
  rw [configsAt_node, otimes, Finset.card_image₂_iff.mpr hinj, cutsAt, cutsAt,
    Finset.card_insert_of_notMem (singleton_notMem_configsAt _ _),
    Finset.card_insert_of_notMem (singleton_notMem_configsAt _ _)]

theorem card_configsAt (t : BTree) (κ : Node) : (t.configsAt κ).card = t.numConfigs := by
  induction t generalizing κ with
  | leaf => rfl
  | node l r hl hr => rw [card_configsAt_node, hl, hr, numConfigs]

end BTree

@[simp] theorem paperConfigs_leaf : paperConfigs leaf = ∅ := rfl

/-- **Eq. (5)** for root configurations: `c(r) = [c(rℓ) + 1][c(rr) + 1]`, where `c(rℓ)`, `c(rr)`
are the numbers of root configurations of the two root subtrees, and `c = 0` for a leaf. -/
theorem card_paperConfigs_node (l r : BTree) :
    (paperConfigs (node l r)).card = ((paperConfigs l).card + 1) * ((paperConfigs r).card + 1) := by
  simp only [paperConfigs, card_configsAt, numConfigs]

/-! ## The main theorem in the paper's terms -/

/-- The restrictions `t(γ)` of the root configurations `γ ∈ C(r)` are exactly the non-trivial
prunings of `T`. -/
theorem image_restrict_paperConfigs (T : BTree) :
    (paperConfigs T).image (restrict T) = T.prunings.erase leaf :=
  (image_restrictAt T []).1

/-- Counting classes: if the trees `f γ` attached to the configurations `γ` are exactly the
non-trivial prunings of `t`, then the number of classes of configurations with isomorphic trees
is `t.rootConfigs`. -/
theorem card_quotient_eq_rootConfigs (t : BTree) {p : Finset Lineage → Prop}
    (f : Finset Lineage → BTree) (hf : ∀ P, (∃ γ, p γ ∧ f γ = P) ↔ P ≠ leaf ∧ P ∈ t.prunings)
    (s : Setoid {γ // p γ}) (hs : ∀ γ₁ γ₂ : {γ // p γ}, s.r γ₁ γ₂ ↔ Iso (f γ₁) (f γ₂)) :
    Nat.card (Quotient s) = t.rootConfigs := by
  let g : Quotient s →
      {σ : Quotient shapeSetoid // ∃ P ∈ t.prunings, P ≠ leaf ∧ Quotient.mk _ P = σ} :=
    Quotient.lift
      (fun γ => ⟨Quotient.mk _ (f γ), f γ, ((hf _).mp ⟨γ, γ.2, rfl⟩).2,
        ((hf _).mp ⟨γ, γ.2, rfl⟩).1, rfl⟩)
      (fun γ₁ γ₂ h => Subtype.ext (Quotient.sound (Relation.EqvGen.rel _ _ ((hs γ₁ γ₂).mp h))))
  have hg : Function.Bijective g := by
    constructor
    · intro x y hxy
      induction x using Quotient.inductionOn with | _ γ₁ =>
      induction y using Quotient.inductionOn with | _ γ₂ =>
      apply Quotient.sound
      exact (hs γ₁ γ₂).mpr ((eqvGen_iff_iso _ _).mp (Quotient.exact (congrArg Subtype.val hxy)))
    · rintro ⟨_, P, hP, hne, rfl⟩
      obtain ⟨γ, hγ, rfl⟩ := (hf P).mpr ⟨hne, hP⟩
      exact ⟨Quotient.mk _ ⟨γ, hγ⟩, rfl⟩
  exact Nat.card_congr (Equiv.ofBijective g hg)

/-- The number `c*(r)` of non-equivalent root configurations, defined as in the paper, is
`BTree.rootConfigs`. -/
theorem paperRootConfigsNonequiv_eq_rootConfigs (T : BTree) :
    paperRootConfigsNonequiv T = T.rootConfigs := by
  apply card_quotient_eq_rootConfigs T (restrict T)
  · intro P
    rw [← Finset.mem_erase, ← image_restrict_paperConfigs, Finset.mem_image]
  · intro γ₁ γ₂
    exact Iff.rfl

/-- `c*(r)` only depends on the tree shape: in particular, which child of a node is called
`rℓ` and which `rr` plays no role (and neither do leaf labels, which never enter). -/
theorem paperRootConfigsNonequiv_iso {T U : BTree} (h : Iso T U) :
    paperRootConfigsNonequiv T = paperRootConfigsNonequiv U := by
  rw [paperRootConfigsNonequiv_eq_rootConfigs, paperRootConfigsNonequiv_eq_rootConfigs,
    h.rootConfigs_eq]

/-- **Disanto–Rosenberg conjecture, in the paper's terms.**  For `n ≥ 2`, `drMax n` is the
largest number `c*(r)` of non-equivalent root ancestral configurations of a tree with `n`
leaves. -/
theorem disanto_rosenberg_paper (n : ℕ) (hn : 2 ≤ n) :
    IsGreatest {k | ∃ T : BTree, T.leaves = n ∧ paperRootConfigsNonequiv T = k} (drMax n) := by
  simpa only [paperRootConfigsNonequiv_eq_rootConfigs] using disanto_rosenberg n hn

/-! ## Non-equivalent configurations at an arbitrary node -/

/-- **Section 3.1.**  Two configurations `γ₁, γ₂ ∈ C(κ)` at a node `κ` of `T` are equivalent at
`κ`, `γ₁ ∼_κ γ₂`, when the tree shape `t_κ(γ₁)` is isomorphic to the tree shape `t_κ(γ₂)`. -/
def configEquivAt (T : BTree) (κ : Node) : Setoid {γ // γ ∈ (T.subtree κ).configsAt κ} where
  r γ₁ γ₂ := Iso ((T.subtree κ).restrictAt κ γ₁) ((T.subtree κ).restrictAt κ γ₂)
  iseqv := ⟨fun _ => Iso.refl _, fun h => h.symm, fun h₁ h₂ => h₁.trans h₂⟩

/-- **Section 3.1.**  The number `c*(κ) = |C*(κ)|` of non-equivalent configurations at the node
`κ` of `T`. -/
noncomputable def nonequivConfigsAt (T : BTree) (κ : Node) : ℕ :=
  Nat.card (Quotient (configEquivAt T κ))

/-- `c*(κ)` is the number of isomorphism classes of non-trivial prunings of the subtree `t_κ`. -/
theorem nonequivConfigsAt_eq_rootConfigs (T : BTree) (κ : Node) :
    nonequivConfigsAt T κ = (T.subtree κ).rootConfigs := by
  apply card_quotient_eq_rootConfigs (T.subtree κ) ((T.subtree κ).restrictAt κ)
  · intro P
    rw [← Finset.mem_erase, ← (image_restrictAt (T.subtree κ) κ).1, Finset.mem_image]
  · intro γ₁ γ₂
    exact Iff.rfl

/-- At the root, `c*(κ)` is `c*(r)`. -/
theorem nonequivConfigsAt_root (T : BTree) :
    nonequivConfigsAt T [] = paperRootConfigsNonequiv T := by
  rw [nonequivConfigsAt_eq_rootConfigs, paperRootConfigsNonequiv_eq_rootConfigs, subtree]

/-! ## The example of Fig. 1 -/

namespace Fig1

/-- The tree `t = ((a, b), ((c, d), (e, f)))` of Fig. 1A of the paper. -/
def t : BTree := node (node leaf leaf) (node (node leaf leaf) (node leaf leaf))

/-- The nodes of Fig. 1A: `k` is the root, `g = (a, b)`, `j = ((c, d), (e, f))`, `h = (c, d)`,
`i = (e, f)`. -/
def k : Node := []
def g : Node := [false]
def j : Node := [true]
def a : Node := [false, false]
def b : Node := [false, true]
def h : Node := [true, false]
def i : Node := [true, true]
def c : Node := [true, false, false]
def d : Node := [true, false, true]
def e : Node := [true, true, false]
def f : Node := [true, true, true]

/-- Section 2.3: `C(g) = {{a, b}}`. -/
example : (t.subtree g).configsAt g = {{a, b}} := by decide +kernel

/-- Section 2.3: `C(j) = {{c, d, e, f}, {h, e, f}, {c, d, i}, {h, i}}`. -/
example : (t.subtree j).configsAt j = {{c, d, e, f}, {h, e, f}, {c, d, i}, {h, i}} := by
  decide +kernel

/-- Section 2.3: the ten root configurations `C(k)` listed in the paper. -/
example : paperConfigs t = {{g, j}, {a, b, j}, {g, c, d, e, f}, {a, b, c, d, e, f},
    {g, h, e, f}, {a, b, h, e, f}, {g, c, d, i}, {a, b, c, d, i}, {g, h, i}, {a, b, h, i}} := by
  decide +kernel

/-- Section 3.1: `t_j({h, e, f})` is the caterpillar shape of size 3. -/
example : (t.subtree j).restrictAt j {h, e, f} = node leaf (node leaf leaf) := by decide +kernel

/-- Section 3.1: `t_k({a, b, h, i})` is the balanced shape of size 4. -/
example : restrict t {a, b, h, i} = node (node leaf leaf) (node leaf leaf) := by decide +kernel

/-- Section 3.1: `{h, e, f} ∼_j {c, d, i}`. -/
example : Iso ((t.subtree j).restrictAt j {h, e, f}) ((t.subtree j).restrictAt j {c, d, i}) :=
  (iso_iff_code_eq _ _).mpr (by decide +kernel)

/-- Section 3.1: `{a, b, j} ∼_k {g, h, i}`. -/
example : Iso (restrict t {a, b, j}) (restrict t {g, h, i}) :=
  (iso_iff_code_eq _ _).mpr (by decide +kernel)

/-- Fig. 2: `C*(j) = {{h, e, f}, {h, i}, {c, d, e, f}}`, so `c*(j) = 3`. -/
example : nonequivConfigsAt t j = 3 := by
  rw [nonequivConfigsAt_eq_rootConfigs, rootConfigs_eq]
  decide +kernel

end Fig1

/-- Section 3.2: "For n = 4, both unlabeled topologies have c*(r) = 3." -/
example : paperRootConfigsNonequiv (node (node leaf leaf) (node leaf leaf)) = 3 ∧
    paperRootConfigsNonequiv (node leaf (node leaf (node leaf leaf))) = 3 := by
  simp only [paperRootConfigsNonequiv_eq_rootConfigs, rootConfigs_eq]
  decide +kernel

/-- Fig. 5: "From n = 2 to n = 20, the largest values of c*(r) follow the sequence 1, 2, 3, 5, 7,
11, 15, 23, 33, 47, 69, 99, 141, 207, 297, 423, 621, 891, 1269." -/
example : (List.range' 2 19).map drMax =
    [1, 2, 3, 5, 7, 11, 15, 23, 33, 47, 69, 99, 141, 207, 297, 423, 621, 891, 1269] := by
  decide +kernel

/-! ## Section 2.3: configurations from realizations

Section 2.3 defines `C(κ) = {C(κ, R) : R ∈ ℜ(G, S)}` (eq. (3)), where `ℜ(G, S)` is the set of
realizations of the gene tree `G` in the species tree `S`, `G = S = t`, and `C(κ, R)` is "the set
of gene lineages, i.e. edges of `G`, that are present in `S` at the point right before node `κ`
looking backward in time"; a leaf has no configurations.  We formalize a realization by the
coalescence times of the gene tree in a dated species tree. -/

/-- A species tree with tree `T` and speciation times: `σ κ` is the time of the node `κ`,
measured backward from the present.  The present-day species (the leaves) are at time `0`, and
every internal node is older than its children. -/
structure SpeciesTree (T : BTree) where
  /-- The time of each node of the species tree. -/
  σ : Node → ℝ
  σ_leaf : ∀ v ∈ T.leafNodes, σ v = 0
  σ_child : ∀ v ∈ T.internalNodes, ∀ b : Bool, σ (v ++ [b]) < σ v

/-- A realization `R ∈ ℜ(G, S)` of the gene tree `G = T` in the species tree `S`, given by the
times `τ v` (backward from the present) of the coalescences at the internal nodes `v` of `G`.
The gene lineages are sampled in the present (`τ = 0` at the leaves) and each node of `G` is
older than its children.  One lineage is sampled per species and `G = S`, so the two lineages
that coalesce at the gene tree node `v` descend from different children of the species tree
node `v`; they can only coalesce in a population ancestral to the species `v`, that is, at a
time `τ v > σ v` older than (above) the speciation at `v`.  (In the multispecies coalescent the
coalescence times of the gene tree `G` have a positive density on exactly this set of `τ`, so
these are the possible evolutionary scenarios; the population in which each coalescence takes
place is determined by `τ` and `σ`.) -/
structure Realization (T : BTree) (S : SpeciesTree T) where
  /-- The coalescence time of each node of the gene tree. -/
  τ : Node → ℝ
  τ_leaf : ∀ v ∈ T.leafNodes, τ v = 0
  τ_child : ∀ v ∈ T.internalNodes, ∀ b : Bool, τ (v ++ [b]) < τ v
  σ_lt_τ : ∀ v ∈ T.internalNodes, S.σ v < τ v

/-- The ancestral configuration `C(κ, R)`: the gene lineages present in the species tree at the
point right before the node `κ`, looking backward in time.  These are the lineages `u` in the two
branches directly below `κ` (so `u` lies strictly below `κ`) that exist at the times `σ κ - ε` for
all small `ε > 0`.  The lineage `u` exists from the time `τ u` of its lower node until the
coalescence `τ (parent u)` of its parent `u.dropLast`, so this means
`τ u < σ κ ≤ τ (parent u)`. -/
noncomputable def Realization.config {T : BTree} {S : SpeciesTree T} (R : Realization T S)
    (κ : Node) : Finset Lineage :=
  T.nodes.filter fun u => (∃ b : Bool, κ ++ [b] <+: u) ∧ R.τ u < S.σ κ ∧ S.σ κ ≤ R.τ u.dropLast

/-- **Eq. (3).**  The set `C(κ) = {C(κ, R) : R ∈ ℜ(G, S)}` of ancestral configurations at a node
`κ`, where (Section 2.3) a leaf has no ancestral configurations. -/
def realizationConfigs (T : BTree) (S : SpeciesTree T) (κ : Node) : Set (Finset Lineage) :=
  {γ | κ ∈ T.internalNodes ∧ ∃ R : Realization T S, R.config κ = γ}

/-- An auxiliary lemma: the lineages of `t_κ` present just below time `s` form a cut of `t_κ`,
provided the lineage above `κ` has not coalesced by then. -/
theorem front_mem_cutsAt (t : BTree) (κ : Node) (τ : Node → ℝ) (s : ℝ)
    (hleaf : ∀ v ∈ t.leafNodesAt κ, τ v = 0)
    (hchild : ∀ v ∈ t.internalNodesAt κ, ∀ b, τ (v ++ [b]) < τ v)
    (hs : 0 < s) (hpar : s ≤ τ κ.dropLast) :
    (t.nodesAt κ).filter (fun u => τ u < s ∧ s ≤ τ u.dropLast) ∈ t.cutsAt κ := by
  induction t generalizing κ with
  | leaf =>
    have h₀ : τ κ = 0 := hleaf κ (by simp [leafNodesAt])
    rw [nodesAt, Finset.filter_singleton, if_pos ⟨by rw [h₀]; exact hs, hpar⟩]
    exact Finset.mem_insert_self _ _
  | node l r hl hr =>
    by_cases hκ : τ κ < s
    · have e : ((node l r).nodesAt κ).filter (fun u => τ u < s ∧ s ≤ τ u.dropLast) = {κ} := by
        ext u
        simp only [Finset.mem_filter, Finset.mem_singleton]
        constructor
        · rintro ⟨hu, -, hu₂⟩
          by_contra hne
          have hp := dropLast_mem_internalNodesAt hu hne
          have := (antitone_nodesAt τ hchild _ (internalNodesAt_subset _ _ hp)).1
          linarith
        · rintro rfl
          exact ⟨self_mem_nodesAt _ _, hκ, hpar⟩
      rw [e]
      exact Finset.mem_insert_self _ _
    · replace hκ : s ≤ τ κ := not_lt.mp hκ
      have e : ((node l r).nodesAt κ).filter (fun u => τ u < s ∧ s ≤ τ u.dropLast) =
          (l.nodesAt (κ ++ [false])).filter (fun u => τ u < s ∧ s ≤ τ u.dropLast) ∪
            (r.nodesAt (κ ++ [true])).filter (fun u => τ u < s ∧ s ≤ τ u.dropLast) := by
        rw [nodesAt, Finset.filter_insert, if_neg (fun h => absurd h.1 (not_lt.mpr hκ)),
          Finset.filter_union]
      have h₁ := hl (κ := κ ++ [false]) (fun v hv => hleaf v (by simp [leafNodesAt, hv]))
        (fun v hv => hchild v (by simp [internalNodesAt, hv]))
        (by rw [List.dropLast_concat]; exact hκ)
      have h₂ := hr (κ := κ ++ [true]) (fun v hv => hleaf v (by simp [leafNodesAt, hv]))
        (fun v hv => hchild v (by simp [internalNodesAt, hv]))
        (by rw [List.dropLast_concat]; exact hκ)
      rw [e]
      apply Finset.mem_insert_of_mem
      rw [configsAt_node, otimes]
      exact Finset.mem_image₂_of_mem h₁ h₂

/-- The subtree generated by an internal node is not a leaf. -/
theorem subtree_eq_node {T : BTree} {κ : Node} (hκ : κ ∈ T.internalNodes) :
    ∃ l r, T.subtree κ = node l r := by
  have hI := (subtree_nodes T (internalNodesAt_subset _ _ hκ)).2.2
  cases h : T.subtree κ with
  | leaf =>
    have : κ ∈ (T.subtree κ).internalNodesAt κ := by
      rw [hI]
      exact Finset.mem_filter.mpr ⟨hκ, List.prefix_refl _⟩
    rw [h] at this
    simp [internalNodesAt] at this
  | node l r => exact ⟨l, r, rfl⟩

/-- The subtree generated by a leaf is a leaf. -/
theorem subtree_eq_leaf {T : BTree} {κ : Node} (hκ : κ ∈ T.nodes) (hi : κ ∉ T.internalNodes) :
    T.subtree κ = leaf := by
  have hI := (subtree_nodes T hκ).2.2
  cases h : T.subtree κ with
  | leaf => rfl
  | node l r =>
    exfalso
    apply hi
    have : κ ∈ (T.subtree κ).internalNodesAt κ := by
      rw [h]
      simp [internalNodesAt]
    rw [hI] at this
    exact (Finset.mem_filter.mp this).1

/-- Every realization gives a configuration of the recursion of Section 2.4. -/
theorem Realization.config_mem {T : BTree} {S : SpeciesTree T} (R : Realization T S) {κ : Node}
    (hκ : κ ∈ T.internalNodes) : R.config κ ∈ (T.subtree κ).configsAt κ := by
  obtain ⟨hN, hL, hI⟩ := subtree_nodes T (internalNodesAt_subset _ _ hκ)
  obtain ⟨l, r, hlr⟩ := subtree_eq_node hκ
  rw [hlr] at hN hL hI ⊢
  have hσ₀ : ∀ u ∈ T.nodes, 0 ≤ S.σ u := nonneg_nodesAt S.σ S.σ_leaf S.σ_child
  have hσκ : 0 < S.σ κ := by
    have h₁ := S.σ_child κ hκ false
    have h₂ := hσ₀ _ (child_mem_nodesAt hκ false)
    linarith
  have hleafT : ∀ v ∈ (node l r).leafNodesAt κ, R.τ v = 0 := by
    intro v hv
    rw [hL] at hv
    exact R.τ_leaf v (Finset.mem_filter.mp hv).1
  have hchildT : ∀ v ∈ (node l r).internalNodesAt κ, ∀ b, R.τ (v ++ [b]) < R.τ v := by
    intro v hv
    rw [hI] at hv
    exact R.τ_child v (Finset.mem_filter.mp hv).1
  have e : R.config κ =
      (l.nodesAt (κ ++ [false])).filter (fun u => R.τ u < S.σ κ ∧ S.σ κ ≤ R.τ u.dropLast) ∪
        (r.nodesAt (κ ++ [true])).filter (fun u => R.τ u < S.σ κ ∧ S.σ κ ≤ R.τ u.dropLast) := by
    ext u
    simp only [Realization.config, Finset.mem_filter, Finset.mem_union]
    constructor
    · rintro ⟨hu, ⟨b, hb⟩, hQ⟩
      have hu' : u ∈ (node l r).nodesAt κ := by
        rw [hN]
        exact Finset.mem_filter.mpr ⟨hu, (List.prefix_append _ _).trans hb⟩
      rw [nodesAt, Finset.mem_insert, Finset.mem_union] at hu'
      rcases hu' with hu' | hu' | hu'
      · rw [hu'] at hb
        exact absurd hb (not_child_prefix_self _ _)
      · exact Or.inl ⟨hu', hQ⟩
      · exact Or.inr ⟨hu', hQ⟩
    · rintro (⟨hu, hQ⟩ | ⟨hu, hQ⟩)
      · have : u ∈ (node l r).nodesAt κ := by simp [nodesAt, hu]
        rw [hN] at this
        exact ⟨(Finset.mem_filter.mp this).1, ⟨false, prefix_of_mem_nodesAt hu⟩, hQ⟩
      · have : u ∈ (node l r).nodesAt κ := by simp [nodesAt, hu]
        rw [hN] at this
        exact ⟨(Finset.mem_filter.mp this).1, ⟨true, prefix_of_mem_nodesAt hu⟩, hQ⟩
  have hpar : ∀ b : Bool, S.σ κ ≤ R.τ (κ ++ [b]).dropLast := by
    intro b
    rw [List.dropLast_concat]
    exact le_of_lt (R.σ_lt_τ κ hκ)
  have h₁ := front_mem_cutsAt l (κ ++ [false]) R.τ (S.σ κ)
    (fun v hv => hleafT v (by simp [leafNodesAt, hv]))
    (fun v hv => hchildT v (by simp [internalNodesAt, hv])) hσκ (hpar false)
  have h₂ := front_mem_cutsAt r (κ ++ [true]) R.τ (S.σ κ)
    (fun v hv => hleafT v (by simp [leafNodesAt, hv]))
    (fun v hv => hchildT v (by simp [internalNodesAt, hv])) hσκ (hpar true)
  rw [e, configsAt_node, otimes]
  exact Finset.mem_image₂_of_mem h₁ h₂

/-- Every configuration of the recursion of Section 2.4 comes from a realization. -/
theorem exists_realization {T : BTree} (S : SpeciesTree T) {κ : Node}
    (hκ : κ ∈ T.internalNodes) {γ : Finset Lineage} (hγ : γ ∈ (T.subtree κ).configsAt κ) :
    ∃ R : Realization T S, R.config κ = γ := by
  classical
  obtain ⟨hN, hL, hI⟩ := subtree_nodes T (internalNodesAt_subset _ _ hκ)
  obtain ⟨hsub, hcov, hanti⟩ := cutsAt_props (Finset.mem_insert_of_mem hγ :
    γ ∈ (T.subtree κ).cutsAt κ)
  have hγT : ∀ x ∈ γ, x ∈ T.nodes := by
    intro x hx
    have := hsub hx
    rw [hN] at this
    exact (Finset.mem_filter.mp this).1
  have hγκ : ∀ x ∈ γ, ∃ b, κ ++ [b] <+: x := fun x hx => below_of_mem_configsAt hγ hx
  have hcov' : ∀ u ∈ T.leafNodes, κ <+: u → ∃ x ∈ γ, x <+: u := by
    intro u hu hκu
    apply hcov u
    rw [hL]
    exact Finset.mem_filter.mpr ⟨hu, hκu⟩
  have hσ₀ : ∀ u ∈ T.nodes, 0 ≤ S.σ u := nonneg_nodesAt S.σ S.σ_leaf S.σ_child
  have hσlt : ∀ u ∈ T.nodes, κ <+: u → u ≠ κ → S.σ u < S.σ κ := by
    intro u hu hκu hne
    have hu' : u ∈ (T.subtree κ).nodesAt κ := by
      rw [hN]
      exact Finset.mem_filter.mpr ⟨hu, hκu⟩
    refine (antitone_nodesAt S.σ ?_ u hu').2 hne
    intro v hv b
    rw [hI] at hv
    exact S.σ_child v (Finset.mem_filter.mp hv).1 b
  have hσκ : 0 < S.σ κ := by
    have h₁ := S.σ_child κ hκ false
    have h₂ := hσ₀ _ (child_mem_nodesAt hκ false)
    linarith
  have hLI : ∀ v ∈ T.internalNodes, v ∉ T.leafNodes := fun v hv hl => not_mem_leaf_internal hl hv
  -- nodes below a lineage of `γ` are strictly below `κ`, hence younger than `κ`
  have hbelow : ∀ v ∈ T.nodes, (∃ x ∈ γ, x <+: v) → S.σ v < S.σ κ := by
    rintro v hv ⟨x, hx, hxv⟩
    obtain ⟨b, hb⟩ := hγκ x hx
    apply hσlt v hv ((List.prefix_append _ _).trans (hb.trans hxv))
    rintro rfl
    exact not_child_prefix_self _ _ (hb.trans hxv)
  -- the coalescence times: the nodes below `γ` coalesce between their speciation and `σ κ`,
  -- all other internal nodes coalesce after `σ κ`
  let τ : Node → ℝ := fun v =>
    if v ∈ T.leafNodes then 0
    else if ∃ x ∈ γ, x <+: v then (S.σ v + S.σ κ) / 2 else S.σ v + S.σ κ + 1
  have τ₁ : ∀ v ∈ T.leafNodes, τ v = 0 := fun v hv => by simp only [τ, hv, if_true]
  have τ₂ : ∀ v, v ∉ T.leafNodes → (∃ x ∈ γ, x <+: v) → τ v = (S.σ v + S.σ κ) / 2 :=
    fun v hv hb => by simp only [τ, hv, hb, if_true, if_false]
  have τ₃ : ∀ v, v ∉ T.leafNodes → ¬ (∃ x ∈ γ, x <+: v) → τ v = S.σ v + S.σ κ + 1 :=
    fun v hv hb => by simp only [τ, hv, hb, if_false]
  refine ⟨⟨τ, τ₁, ?_, ?_⟩, ?_⟩
  · intro v hv b
    have hvL := hLI v hv
    have hc : v ++ [b] ∈ T.nodes := child_mem_nodesAt hv b
    have hσc := S.σ_child v hv b
    have hσc₀ := hσ₀ _ hc
    have hσv₀ := hσ₀ v (internalNodesAt_subset _ _ hv)
    by_cases hcL : v ++ [b] ∈ T.leafNodes
    · rw [τ₁ _ hcL]
      by_cases hbv : ∃ x ∈ γ, x <+: v
      · rw [τ₂ v hvL hbv]
        linarith
      · rw [τ₃ v hvL hbv]
        linarith
    · by_cases hbc : ∃ x ∈ γ, x <+: v ++ [b]
      · rw [τ₂ _ hcL hbc]
        have := hbelow _ hc hbc
        by_cases hbv : ∃ x ∈ γ, x <+: v
        · rw [τ₂ v hvL hbv]
          linarith
        · rw [τ₃ v hvL hbv]
          linarith
      · have hbv : ¬ ∃ x ∈ γ, x <+: v := fun ⟨x, hx, hxv⟩ =>
          hbc ⟨x, hx, hxv.trans (List.prefix_append _ _)⟩
        rw [τ₃ _ hcL hbc, τ₃ v hvL hbv]
        linarith
  · intro v hv
    have hvL := hLI v hv
    by_cases hbv : ∃ x ∈ γ, x <+: v
    · rw [τ₂ v hvL hbv]
      have := hbelow v (internalNodesAt_subset _ _ hv) hbv
      linarith
    · rw [τ₃ v hvL hbv]
      linarith
  · ext u
    simp only [Realization.config, Finset.mem_filter]
    constructor
    · rintro ⟨hu, ⟨b, hb⟩, h₁, h₂⟩
      have hκu : κ <+: u := (List.prefix_append _ _).trans hb
      have hne : u ≠ [] := by
        rintro rfl
        have := hb.length_le
        simp at this
      have hpI : u.dropLast ∈ T.internalNodes := dropLast_mem_internalNodesAt hu hne
      have hbu : ∃ x ∈ γ, x <+: u := by
        by_cases huL : u ∈ T.leafNodes
        · exact hcov' u huL hκu
        · by_contra hbu
          change τ u < S.σ κ at h₁
          rw [τ₃ u huL hbu] at h₁
          linarith [hσ₀ u hu]
      have hbp : ¬ ∃ x ∈ γ, x <+: u.dropLast := by
        intro hbp
        change S.σ κ ≤ τ u.dropLast at h₂
        rw [τ₂ _ (hLI _ hpI) hbp] at h₂
        have := hbelow _ (internalNodesAt_subset _ _ hpI) hbp
        linarith
      obtain ⟨x, hx, hxu⟩ := hbu
      by_cases hxu' : x = u
      · rw [← hxu']
        exact hx
      · exact absurd ⟨x, hx, prefix_dropLast_of_ne hxu hxu'⟩ hbp
    · intro hu
      obtain ⟨b, hb⟩ := hγκ u hu
      have huT := hγT u hu
      have hne : u ≠ [] := by
        rintro rfl
        have := hb.length_le
        simp at this
      have hpI : u.dropLast ∈ T.internalNodes := dropLast_mem_internalNodesAt huT hne
      refine ⟨huT, ⟨b, hb⟩, ?_, ?_⟩
      · by_cases huL : u ∈ T.leafNodes
        · rw [τ₁ u huL]
          exact hσκ
        · rw [τ₂ u huL ⟨u, hu, List.prefix_refl _⟩]
          have := hbelow u huT ⟨u, hu, List.prefix_refl _⟩
          linarith
      · have hbp : ¬ ∃ x ∈ γ, x <+: u.dropLast := by
          rintro ⟨y, hy, hyp⟩
          have hyu := hanti y hy u hu (hyp.trans (List.dropLast_prefix u))
          rw [hyu] at hyp
          have h₁ := hyp.length_le
          rw [List.length_dropLast] at h₁
          have h₂ := List.length_pos_of_ne_nil hne
          omega
        rw [τ₃ _ (hLI _ hpI) hbp]
        linarith [hσ₀ _ (internalNodesAt_subset _ _ hpI)]

/-- **Section 2.3 = Section 2.4.**  At every node `κ` of `T`, the configurations defined from
realizations (eq. (3)) are the configurations of the recursion of Section 2.4, for every dated
species tree `S`. -/
theorem realizationConfigs_eq_configsAt (T : BTree) (S : SpeciesTree T) {κ : Node}
    (hκ : κ ∈ T.nodes) : realizationConfigs T S κ = ↑((T.subtree κ).configsAt κ) := by
  ext γ
  simp only [realizationConfigs, Set.mem_ofPred_eq, Finset.mem_coe]
  by_cases hi : κ ∈ T.internalNodes
  · constructor
    · rintro ⟨-, R, rfl⟩
      exact R.config_mem hi
    · intro hγ
      exact ⟨hi, exists_realization S hi hγ⟩
  · simp [hi, subtree_eq_leaf hκ hi]

/-- The root configurations defined from realizations are `paperConfigs T`. -/
theorem realizationConfigs_root (T : BTree) (S : SpeciesTree T) :
    realizationConfigs T S [] = ↑(paperConfigs T) := by
  rw [realizationConfigs_eq_configsAt T S (self_mem_nodesAt T [])]
  simp [subtree, paperConfigs]

/-- Section 3.1 for the root configurations defined from realizations. -/
def realizationRootConfigEquiv (T : BTree) (S : SpeciesTree T) :
    Setoid {γ // γ ∈ realizationConfigs T S []} where
  r γ₁ γ₂ := Iso (restrict T γ₁) (restrict T γ₂)
  iseqv := ⟨fun _ => Iso.refl _, fun h => h.symm, fun h₁ h₂ => h₁.trans h₂⟩

/-- The number `c*(r)` of non-equivalent root configurations, with the configurations defined
from realizations (Sections 2.3 and 3.1). -/
noncomputable def realizationRootConfigsNonequiv (T : BTree) (S : SpeciesTree T) : ℕ :=
  Nat.card (Quotient (realizationRootConfigEquiv T S))

theorem realizationRootConfigsNonequiv_eq_rootConfigs (T : BTree) (S : SpeciesTree T) :
    realizationRootConfigsNonequiv T S = T.rootConfigs := by
  apply card_quotient_eq_rootConfigs T (restrict T)
  · intro P
    rw [realizationConfigs_root, ← Finset.mem_erase, ← image_restrict_paperConfigs,
      Finset.mem_image]
    simp only [Finset.mem_coe]
  · intro γ₁ γ₂
    exact Iff.rfl

/-- Every tree can be dated: the time of a node is the number of nodes strictly below it. -/
noncomputable def SpeciesTree.canonical (T : BTree) : SpeciesTree T where
  σ v := ((T.nodes.filter (v <+: ·)).card : ℝ) - 1
  σ_leaf := by
    intro v hv
    have hvn : v ∈ T.nodes := leafNodesAt_subset _ _ hv
    have hvi : v ∉ T.internalNodes := fun hi => not_mem_leaf_internal hv hi
    rw [← (subtree_nodes T hvn).1, subtree_eq_leaf hvn hvi, nodesAt]
    simp
  σ_child := by
    intro v hv b
    have hlt : (T.nodes.filter ((v ++ [b]) <+: ·)).card < (T.nodes.filter (v <+: ·)).card := by
      apply Finset.card_lt_card
      rw [Finset.ssubset_iff_of_subset]
      · exact ⟨v, Finset.mem_filter.mpr ⟨internalNodesAt_subset _ _ hv, List.prefix_refl _⟩,
          fun h => not_child_prefix_self v b (Finset.mem_filter.mp h).2⟩
      · intro u hu
        rw [Finset.mem_filter] at hu ⊢
        exact ⟨hu.1, (List.prefix_append _ _).trans hu.2⟩
    have : ((T.nodes.filter ((v ++ [b]) <+: ·)).card : ℝ) <
        ((T.nodes.filter (v <+: ·)).card : ℝ) := by exact_mod_cast hlt
    linarith

/-- **Disanto–Rosenberg conjecture, with the configurations of Section 2.3.**  For `n ≥ 2`,
`drMax n` is the largest number of non-equivalent root ancestral configurations of a species tree
with `n` leaves (any topology and any speciation times), where the ancestral configurations are
defined from the realizations of the matching gene tree. -/
theorem disanto_rosenberg_realizations (n : ℕ) (hn : 2 ≤ n) :
    IsGreatest {k | ∃ (T : BTree) (S : SpeciesTree T), T.leaves = n ∧
      realizationRootConfigsNonequiv T S = k} (drMax n) := by
  have h := disanto_rosenberg n hn
  constructor
  · obtain ⟨T, hT, hk⟩ := h.1
    exact ⟨T, SpeciesTree.canonical T, hT,
      by rw [realizationRootConfigsNonequiv_eq_rootConfigs, hk]⟩
  · rintro k ⟨T, S, hT, rfl⟩
    rw [realizationRootConfigsNonequiv_eq_rootConfigs]
    exact h.2 ⟨T, hT, rfl⟩

end KOS.AncestralConfigurations
